{
  "name": "music-composition.js",
  "version": "1.0.0-beta.1",
  "description": "Client-side procedural music generator. Composes a song from a seed and renders it to WAV — no server, no dependencies.",
  "main": "music-composition.js",
  "types": "music-composition.d.ts",
  "exports": {
    ".": {
      "types": "./music-composition.d.ts",
      "default": "./music-composition.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "music-composition.js",
  "jsdelivr": "music-composition.js",
  "files": [
    "music-composition.js",
    "music-composition.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && python3 -m http.server 8765 -d site",
    "test": "node test/test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "music",
    "bgm",
    "procedural",
    "generative",
    "composition",
    "synthesizer",
    "wav",
    "audio",
    "chiptune",
    "lofi",
    "game"
  ],
  "author": "siyukatu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siyukatu/music-composition.js.git"
  },
  "homepage": "https://mcj.siyukatu.me/",
  "bugs": {
    "url": "https://github.com/siyukatu/music-composition.js/issues"
  }
}

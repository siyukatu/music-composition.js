# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

# Keep the *.pages.dev copy out of search results; mcj.siyukatu.me is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/og.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The service worker and the manifest are always revalidated, so updates reach
# installed apps right away.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# The page is revalidated on every load, so a deploy's new script URLs
# (?h=<hash>, stamped by scripts/build.js) are picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
